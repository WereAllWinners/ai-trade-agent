# .env.live — live-account overrides loaded after .env by the live service files.
#
# Copy this file to .env.live and fill in your Alpaca LIVE credentials.
# The service loads .env first (paper credentials + shared config), then this
# file on top — so only the live-specific overrides need to be here.
#
# DO NOT commit .env.live — it contains real API keys.

# Alpaca LIVE account credentials (from alpaca.markets → Live Trading)
# These exact variable names are required — the agents read ALPACA_API_KEY
# and ALPACA_SECRET_KEY (not *_LIVE suffixed variants).
ALPACA_API_KEY=your_live_api_key_here
ALPACA_SECRET_KEY=your_live_secret_key_here

# Must be set here explicitly — the EnvironmentFile= load order means the
# PAPER_TRADING=true in .env would otherwise win.
PAPER_TRADING=false

# Equity at which the options bot goes live (default: $5,000).
OPTIONS_LIVE_THRESHOLD=5000

# Minimum cash to keep uninvested as a buffer (default: $75).
MIN_CASH_RESERVE=75

# Equity at which full allocation params unlock and PDT guard relaxes (default: $2,000).
# LIVE_EQUITY_THRESHOLD=2000

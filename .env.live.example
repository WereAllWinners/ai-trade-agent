# .env.live — live-account overrides for ai-options-bot-live.service
#
# Copy this file to .env.live and fill in your Alpaca LIVE credentials.
# The service loads .env first (paper credentials + shared config), then this
# file on top — so only the live-specific overrides need to be here.
#
# DO NOT commit .env.live — it contains real API keys.

# Alpaca LIVE account credentials (from alpaca.markets → Live Trading)
ALPACA_API_KEY_LIVE=your_live_api_key_here
ALPACA_API_SECRET_LIVE=your_live_secret_key_here

# Safety ceiling: live options bot will auto-switch to standard (full-account)
# params and enable stock live trading once equity reaches this threshold.
# The default is $25,000 (PDT rule minimum). Adjust only if you understand the
# implications — do NOT set below $25,000 for the stock bot gate.
# LIVE_EQUITY_THRESHOLD=25000

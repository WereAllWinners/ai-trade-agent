# Environment
.env
*.env
.env.live
*.env.live
# Timestamped .env backups hold real credentials and match none of the
# patterns above (*.env only matches names *ending* in .env).
.env.bak*

# Python
__pycache__/
*.pyc
venv/
ai-trade-venv/

# Logs
logs/
*.log
*.jsonl
*.json

# Keep curated knowledge base files (committed to repo)
!knowledge/*.jsonl
!data/macro_event_calendar.json

# Local symlink farm pointing into the HuggingFace cache — not repo content
unsloth/

# Model files — ignore checkpoint dirs/symlinks, not training scripts
finetune/finance_qwen_32b*
*.safetensors
*.bin
*.gguf

# Cache
.cache/
__pycache__/
unsloth_compiled_cache/
CLAUDE.md

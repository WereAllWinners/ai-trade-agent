[Unit]
Description=AI Stock Trading Bot (autonomous_agent via trading_daemon)
After=network-online.target ai-inference-server.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/zgx/personal-projects/ai-trade-agent

# Load environment variables from .env
EnvironmentFile=/home/zgx/personal-projects/ai-trade-agent/.env

# Use the venv Python if present, otherwise system Python
ExecStart=/home/zgx/personal-projects/ai-trade-agent/venv/bin/python \
    /home/zgx/personal-projects/ai-trade-agent/scripts/trading_daemon.py

# Restart on crash (but not on clean exit)
Restart=on-failure
RestartSec=30s

# Log to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-trading-bot

[Install]
WantedBy=default.target

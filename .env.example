# ============================================================
# AI Trade Agent - Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- Alpaca API Credentials ---
# Obtain from https://alpaca.markets/ (Paper or Live account)
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# --- Trading Mode ---
# IMPORTANT: Keep this set to 'true' until you have validated the
# strategy with months of paper trading.
# Set to 'false' ONLY when you are ready for live trading and have:
#   - $25,000+ equity (to avoid PDT rule for day trading stocks)
#   - Options Level 2+ approval from Alpaca
#   - Reviewed Alpaca TOS for automated bots
#   - Run the system in paper mode for 1-3 months with positive results
PAPER_TRADING=true

# --- Model Configuration (optional overrides) ---
# Base model ID on Hugging Face (default: Qwen/Qwen2.5-32B-Instruct)
# BASE_MODEL=Qwen/Qwen2.5-32B-Instruct

# Absolute path to your LoRA adapter directory.
# Defaults to <repo_root>/finetune/finance_qwen_32b_lora
# LORA_ADAPTER_PATH=/path/to/your/lora/adapter

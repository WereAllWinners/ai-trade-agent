# ============================================================
# AI Trade Agent - Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# --- Alpaca API Credentials ---
# Obtain from https://alpaca.markets/ (Paper or Live account)
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# --- Trading Mode ---
# IMPORTANT: Keep this set to 'true' until you have validated the
# strategy with months of paper trading.
# Set to 'false' ONLY when you are ready for live trading and have:
#   - $2,000+ equity (to avoid PDT rule for day trading stocks)
#   - Options Level 2+ approval from Alpaca
#   - Reviewed Alpaca TOS for automated bots
#   - Run the system in paper mode for 1-3 months with positive results
PAPER_TRADING=true

# --- Dry-Run Mode ---
# Set to 'true' to log all orders without submitting them to Alpaca.
# Use this for shadow trading / paper simulation before going live.
# Both bots respect this flag — set once, applies everywhere.
# DRY_RUN=false

# --- Inference Backend ---
# Select the LLM inference backend: ollama (default) or vllm.
# INFERENCE_BACKEND=ollama

# Ollama model tag used by both trading bots for decision making.
# OLLAMA_MODEL=qwen3:8b

# vLLM backend — uncomment and configure when INFERENCE_BACKEND=vllm.
# vLLM gives 3-5× faster inference via PagedAttention + continuous batching.
# Requires a running vLLM server (see scripts/start_vllm_server.sh).
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
# VLLM_API_KEY=token
# INFERENCE_TIMEOUT=45

# --- Model Configuration (optional overrides) ---
# HuggingFace token — required when fine-tuning with gated models (e.g. meta-llama/*).
# Create one at https://huggingface.co/settings/tokens (read access is sufficient).
# HUGGINGFACE_TOKEN=hf_your_token_here

# Base model ID on Hugging Face (default: Qwen/Qwen2.5-32B-Instruct)
# BASE_MODEL=Qwen/Qwen2.5-32B-Instruct

# Absolute path to your LoRA adapter directory.
# Defaults to <repo_root>/finetune/finance_qwen_32b_lora
# LORA_ADAPTER_PATH=/path/to/your/lora/adapter

# --- Portfolio Overseer (optional overrides) ---
# Max fraction of equity allowed in any single GICS sector (default: 30%).
# MAX_SECTOR_PCT=0.30
# Max open positions from the same sector before new buys are blocked (default: 4).
# MAX_CORR_POSITIONS=4
# How long (seconds) open-position data is cached before re-fetching (default: 60).
# OVERSEER_CACHE_TTL=60

# --- Allocation Controller (optional overrides) ---
# Tier-2 gate: minimum trades, Sharpe, and max draw-down thresholds.
# ALLOC_MIN_TRADES_T2=20
# ALLOC_SHARPE_T2=1.0
# ALLOC_MAX_DD_T2=0.08
# Tier-3 gate (full production sizing).
# ALLOC_MIN_TRADES_T3=50
# ALLOC_SHARPE_T3=1.5
# ALLOC_MAX_DD_T3=0.05
# Position size per tier as a fraction of equity.
# ALLOC_TIER1_PCT=0.01
# ALLOC_TIER2_PCT=0.03
# ALLOC_TIER3_PCT=0.05

# --- Preflight Check (optional overrides) ---
# Minimum Alpaca options approval level required to run the options daemon (default: 2).
# REQUIRED_OPTIONS_LEVEL=2
# Minimum buying power required to start trading (default: $500).
# MIN_BUYING_POWER=500

# --- Health Server (optional overrides) ---
# Port the health / metrics server listens on (default: 8765).
# HEALTH_PORT=8765
# Max acceptable daemon heartbeat age in seconds before reporting degraded (default: 300).
# HEALTH_MAX_AGE_SECONDS=300

# --- News Sentiment (optional overrides) ---
# Set NEWS_LLM_SENTIMENT=false to fall back to keyword matching if GPU is under
# heavy load during market hours (disables LLM call in news_fetcher, no restart needed).
# NEWS_LLM_SENTIMENT=true

# --- Economic Calendar Guard ---
# Fetches today's high-impact US macro events from Finnhub (free tier: 60 calls/min).
# The guard halts trading within ±30/60 min of FOMC, NFP, and CPI releases.
# Set MACRO_GUARD_ENABLED=false to disable without restarting the daemon.
# MACRO_GUARD_ENABLED=true
# FINNHUB_API_KEY=your_finnhub_api_key_here   # free at https://finnhub.io

# --- Email Alerts (optional) ---
# Leave blank to disable email alerts (file log is always active at logs/alerts.jsonl).
# For Gmail: create an App Password at https://myaccount.google.com/apppasswords
# ALERT_EMAIL_FROM=yourbot@gmail.com
# ALERT_EMAIL_TO=you@example.com
# ALERT_SMTP_HOST=smtp.gmail.com
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=yourbot@gmail.com
# ALERT_SMTP_PASSWORD=your_app_password_here

# --- Liquidity Filters (optional overrides) ---
# Minimum average daily volume for stock candidates (default: 1,000,000 shares).
# MIN_AVG_DAILY_VOLUME_STOCKS=1000000
# Minimum market cap for stock candidates (default: $500M).
# MIN_MARKET_CAP=500000000
# Minimum open interest for option contracts (default: 200 contracts).
# MIN_OPEN_INTEREST_OPTIONS=200
# Minimum quote depth (bid+ask size) for option contracts (default: 50).
# MIN_OPTION_VOLUME=50

# --- Telegram Alerts (optional) ---
# Create a bot via @BotFather on Telegram to get a token.
# Get your chat ID by messaging @userinfobot or from the Telegram API.
# Set TELEGRAM_ALERTS_ENABLED=false to silence Telegram without removing credentials.
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here
# TELEGRAM_ALERTS_ENABLED=true
